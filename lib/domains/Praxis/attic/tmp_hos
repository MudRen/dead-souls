#include <daemons.h>

inherit "/lib/std/room";

#define COST    money/bonus
#define MAX_DONATION 600

mapping blood;

void init() {
    ::init();
    add_action("new_body", "renew");
    add_action("clean_poison", "clean");
    add_action("regenerate", "regenerate");
    add_action("read", "read");
    add_action("donate", "donate");
    add_action("transfuse", "transfuse");
}

void create() {
    seteuid(getuid());
    SetProperty("light", 2);
    SetProperty("indoors", 1);
    SetShort("普拉克斯牧师医院");
    SetLong(
	"你身处镇上的牧师们经营的本地医院。\n"+
	"他们在这里专门从事断肢再生的工作。\n"+
	"墙上张贴着他们提供的所有服务的列表。\n"
    );
    set_item_descriptions(
	({
	"list", "hospital", "clerics", "cleric"
	}),
	({
	"你可以输入 <read list> 查看所有服务。\n",
	"这里的牧师专门从事断肢再生。\n",
	"他们正在治疗患者的伤口。\n",
	"他正在治疗一位患者的伤口。\n"
	})
    );
    SetExits( ([
      	"east"	 : 	"/domains/Praxis/n_centre2"	,
      ]) );
    blood = ([ "who": ([]), "hp":200, "mp":200 ]);
    SetProperty("no teleport", 1);
}

int new_body(string str) {
    object *inv;
    int i;


    if( (int)this_player()->query_level() != 1) {
	notify_fail("牧师们只为新手提供这项服务。\n");
	return 0;
    }
    inv = all_inventory(this_player());
    for(i=0; i<sizeof(inv); i++) {
	inv[i]->unequip();
    }
    write("一位牧师走过来，低声祈祷。\n");
    write("你又重新拥有了生来就有的所有肢体！\n");
    say("一位牧师为新手 "+this_player()->query_cap_name()+" 低声祈祷。\n", this_player());
    this_player()->new_body();
    return 1;
}

int read(string str) {
    if(!str) {
	notify_fail("读什么？\n");
	return 0;
    }
    if(str != "list") {
	notify_fail("这里没有那个可以阅读。\n");
	return 0;
    }
    write("欢迎来到普拉克斯牧师医院！\n"+
	"牧师们提供以下服务：\n"+
	"------------------------------------------------------------------\n"+
	"<renew body>：这是牧师为在冒险中失去肢体的\n"+
	"	新手冒险者提供的慈善服务。所有肢体都会被替换。\n\n"+
	"<regenerate [肢体]>：这项服务面向失去肢体的\n"+
	"	资深冒险者。肢体将被再生，如同全新。\n"+
	"	再生费用表：\n"+
	"               手和脚 -     400 金币\n");
    write("               手臂和腿 -     600 金币\n"+
	"<clean poison>：帮助清除体内的一些毒素。\n"+
	"\t费用：50 金币\n"+
	"<donate # (hp 或 mp) of blood>：捐献一些血液以换取金币。\n"+
	"<transfuse # (hp 或 mp)>：将一些血液转化为 hp 或 mp 输入你的身体\n"+
	"\t费用：数量 × 3 金币\n"+
	"目前库存："+blood["hp"]+" hp 血液和 "+blood["mp"]+" mp 血液可用。\n"+
	"------------------------------------------------------------------\n"+
        "携带断肢可享再生半价优惠！\n"+
 	"你的捐献仅用于善事。\n");
    return 1;
}

int clean_poison(string str) {
    object tp;

    if(!str) return 0;
    if(str != "poison") return 0;
    tp = this_player();
    if((int)tp->query_poisoning()<1) {
	notify_fail("一位牧师低声告诉你：你没有中毒啊！\n");
	return 0;
    }
    if((int)tp->query_money("gold") < 50) {
	notify_fail("你没有足够的金币支付费用。\n");
	return 0;
    }
    tp->add_money("gold", -50);
    tp->add_poisoning(-10);
    write("一位牧师对你施展了治愈法术。\n");
    say("一位牧师对 "+tp->query_cap_name()+" 施展了治愈法术。\n", tp);
    return 1;
}

int regenerate(string limb) {
    int money, bonus;
    mapping limb_info;
    object tp;
    string *there, *missing;

    tp = this_player();
    if(present(limb, this_player())) bonus = 2;
    else bonus = 1;
    there = (string *)tp->query_limbs();
    missing = (string *)this_player()->query_severed_limbs() +
      (string *)RACE_D->query_limbs((string)this_player()->query_race());
/*
   checking with the race_d is allowing compatibility with old
   versions of the mudlib
*/
    if(!missing) {
	notify_fail("你没有缺少任何肢体！\n");
	return 0;
    }
    if(member_array(limb, missing) == -1) {
	notify_fail("你没有缺少那个肢体！\n");
	return 0;
    }
    if(member_array(limb, there) != -1) {
	notify_fail("你已经恢复了那个肢体！\n");
	return 0;
    }
    limb_info= (mapping)RACE_D->query_limb_info(limb,(string)tp->query_race());
    if(!limb_info) {
        notify_fail("那个肢体无法再生！\n");
        return 0;
    }
    if(limb_info["ref"] != "") {
        if(member_array(limb_info["ref"], there) == -1) {
            notify_fail("你需要一个"+limb_info["ref"]+"才行！\n");
	    return 0;
	}
    }
    if((string)this_player()->query_class() == "cleric") money = 1200;
    else money = 1600;
    money = money / limb_info["max"];
    if((int)tp->query_money("gold") < COST) {
	notify_fail("牧师告诉你：你没有足够的金币。\n");
	return 0;
    }
    tp->AddLimb(limb, limb_info["ref"], (int)tp->query_max_hp()/limb_info["max"], 0, 0);
    if(member_array(limb, (string *)RACE_D->query_wielding_limbs((string)tp->qyery_race())) != -1) 
        tp->add_wielding_limb(limb);
	tp->add_money("gold", -COST);
    if(limb == "left hand") {
	if(member_array("left arm", there) == -1) {
	    notify_fail("你需要一条左臂才行！\n");
	    return 0;
	}
        money = 400;
	if((int)tp->query_money("gold") < COST) {
	    notify_fail("牧师告诉你：你没有足够的金币。\n");
	    return 0;
	}
	tp->AddLimb(limb, "", (int)tp->query_max_hp()/4, 0, 0);
        tp->add_wielding_limb(limb);
	tp->add_money("gold", -COST);
    }
    else if(limb == "left foot" || limb == "right foot") {
        money = 400;
        if((int)tp->query_money("gold") < COST) {
            notify_fail("牧师说：你没有足够的金币支付费用。\n");
            return 0;
        }
        if( (limb == "left foot" && member_array("left leg", there) == -1) || (limb == "right foot" && member_array("right leg", there) == -1) ) {
            notify_fail("你需要一个肢体来连接！\n");
            return 0;
        }
        tp->AddLimb(limb, "", (int)tp->query_max_hp()/4, 0, 0);
        tp->add_money("gold", -COST);
    }
    else if(limb == "left arm" || limb == "left leg" || limb == "right arm" || limb == "right leg") {
        money = 600;
	if((int)tp->query_money("gold") < COST) {
	    notify_fail("牧师告诉你：你没有足够的金币支付费用。\n");
	    return 0;
	}
	if(limb == "left arm") tp->AddLimb(limb, "left hand", (int)tp->query_max_hp()/3, 0, 0);
        else if(limb == "left leg") tp->AddLimb(limb, "left foot", (int)tp->query_max_hp()/3, 0, 0);
        else if(limb == "right leg") tp->AddLimb(limb, "right foot", (int)tp->query_max_hp()/3, 0, 0);
	else tp->AddLimb(limb, "right hand", (int)tp->query_max_hp()/3, 0, 0);
	tp->add_money("gold", -COST);
    }
    else {
	write("牧师说：抱歉，我们没有能力做到那个。\n");
	say("一位牧师悲伤地看着 "+tp->query_cap_name()+"。\n", tp);
	return 1;
    }
    say(tp->query_cap_name()+"请求牧师帮助恢复"+tp->query_possessive()+"缺失的"+limb+"。\n", tp);
    write("牧师们恢复了你的"+limb+"！\n");
    return 1;
}

int donate(string str) {
    string what;
    int amount, tmp;
 
    if(!str) {
	notify_fail("捐献什么？\n");
	return 0;
    }
    if(sscanf(str, "%d %s of blood", amount, what) !=2) {
	notify_fail("正确语法：<donate [数量] [hp | mp] of blood>\n");
	return 0;
    }
    if(what != "mp" && what != "hp") {
	notify_fail("捐献什么？\n");
	return 0;
    }
    if(blood[(string)this_player()->query_name()]+amount > MAX_DONATION) {
	write("你需要等一会儿才能再捐献那么多血液。\n");
	return 1;
    }
    tmp = (int)call_other(this_player(), "query_"+what);
    if(tmp < amount + 5) {
	notify_fail("你至少要比计划捐献的量多 5 点！\n");
	return 0;
    }
    call_other(this_player(), "add_"+what, -amount);
    this_player()->add_money("gold", amount/2);
    blood[what] += amount;
    blood["who"][(string)this_player()->query_name()] += amount;
    write("你捐献了一些血液，获得了 "+(amount/2)+" 枚金币。\n");
    say(this_player()->query_cap_name()+"捐献了一些血液换取金币。\n", this_player());
    call_out("reduce_donation", 900, ({ this_player(), amount }));
    return 1;
}

int transfuse(string str) {
    string what;
    int amount;

    if(!str) {
	notify_fail("输血什么？\n");
	return 0;
    }
    if(sscanf(str, "%d %s", amount, what) != 2) {
	notify_fail("正确语法：<transfuse [数量] [mp | hp]>\n");
	return 0;
    }
    if(what != "hp" && what != "mp") {
	notify_fail("你不能那样做！\n");
	return 0;
    }
    if(amount < 1) {
        notify_fail("你疯了吗？！\n");
        return 0;
    }
    if(blood[what] < amount) {
	notify_fail("我们目前没有那么多血液库存。\n");
	return 0;
    }
    if((int)this_player()->query_money("gold") < amount*3) {
	notify_fail("你没有足够的金币支付费用。\n");
	return 0;
    }
    this_player()->add_money("gold", -(amount*3));
    call_other(this_player(), "add_"+what, amount);
    write("你接受了一次输血。\n");
    say(this_player()->query_cap_name()+"接受了一次输血。\n", this_player());
    return 1;
}

void reduce_donation(mixed *tmp) {
    blood["who"][tmp[0]] -= tmp[1];
    if(blood["who"][tmp[0]] < 1) map_delete(blood, tmp[0]);
}
